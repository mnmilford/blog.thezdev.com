---
import '../styles/global.css';
import { SITE, SECTIONS } from '../site';
import { tagSlug } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  /** Let the page lay out its own columns (post pages with a contents sidebar). */
  wide?: boolean;
  /** Section to mark as current in the header (a post's broad tag). */
  section?: string;
}

const { title, description = SITE.description, type = 'website', published, wide = false, section } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const nav = SECTIONS.map((name) => {
  const href = `/tags/${tagSlug(name)}/`;
  const here = path === href;
  return { name, href, current: here ? 'page' : section === name ? 'true' : undefined };
});
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.title} home`}>
          <span class="brand-mark" aria-hidden="true">Z</span>
          <span class="brand-name">{SITE.name}</span>
          <span class="brand-sub">Blog</span>
        </a>
        <nav aria-label="Sections">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.current}>{item.name}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class:list={['wrap', { wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} {SITE.name}. Written by {SITE.author}.</p>
        <p class="footer-links"><a href="/tags/">All topics</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </footer>
  </body>
</html>
